{
  "name": "aigent-desktop",
  "version": "0.2.0",
  "description": "AIGent desktop - Codex, Claude and DeepSeek in one local agent workspace",
  "author": "AIGent contributors",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "test": "node --test ui.test.cjs",
    "start": "electron .",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win portable",
    "build:ui": "esbuild ui-entry.js --bundle --minify --format=iife --outfile=../connector/static/widgets.js --legal-comments=linked",
    "install:electron": "install-electron"
  },
  "devDependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@openai/codex": "^0.154.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1"
  },
  "build": {
    "appId": "org.eschota.aigent",
    "productName": "AIGent",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json",
      "assets/*",
      {
        "from": "../connector/static",
        "to": "shared",
        "filter": [
          "zoom.js"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "../.local/build/backend/AIGentServer",
        "to": "backend"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "AIGent-${version}-portable.exe"
    }
  }
}
